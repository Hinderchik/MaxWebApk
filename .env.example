// ============================================
// 🔥 FIREBASE CONFIG — ENV VARS
// Все ключи вынесены через .env для безопасности
// Загрузите в CI/CD или локально перед сборкой
// ============================================

/**
 * Firebase Config (загружается из .env при сборке)
 * Переменные окружения:
 *   FIREBASE_API_KEY
 *   FIREBASE_AUTH_DOMAIN
 *   FIREBASE_DATABASE_URL
 *   FIREBASE_PROJECT_ID
 *   FIREBASE_STORAGE_BUCKET
 *   FIREBASE_MESSAGING_SENDER_ID
 *   FIREBASE_APP_ID
 *   FIREBASE_MEASUREMENT_ID
 */

export const firebaseConfig = {
  apiKey: process.env.FIREBASE_API_KEY || 'AIzaSyAz2dkis9NgvZDFCq9CLqPbDL61Cp7XLAE',
  authDomain: process.env.FIREBASE_AUTH_DOMAIN || 'chess-cc-messanger.firebaseapp.com',
  databaseURL: process.env.FIREBASE_DATABASE_URL || 'https://chess-cc-messanger-default-rtdb.firebaseio.com',
  projectId: processEnv_FIREBASE_PROJECT_ID || 'chess-cc-messanger',
  storageBucket: process.env.FIREBASE_STORAGE_BUCKET || 'chess-cc-messanger.firebasestorage.app',
  messagingSenderId: process.env.FIREBASE_MESSAGING_SENDER_ID || '681157216826',
  appId: process.env.FIREBASE_APP_ID || '1:681157216826:web:6ec88f4ac9b02219850303',
  measurementId: process.env.FIREBASE_MEASUREMENT_ID || 'G-DK84QH1JYN',
};

// ============================================
// 🔥 ВНЕШНИЕ API ENDPOINTS
// ============================================

export const API_ENDPOINTS = {
  // FCM серверный ключ (хранить в секретах!)
  FCM_SERVER_KEY: process.env.FCM_SERVER_KEY || '',
  
  // Push-уведомления: регистрация токена
  REGISTER_FCM_TOKEN: `${process.env.API_BASE_URL}/fcm/register`,
  
  // Отправка уведомления пользователю
  SEND_NOTIFICATION: `${process.env.API_BASE_URL}/notifications/send`,
  
  // Отправка звонка
  SEND_CALL_REQUEST: `${process.env.API_BASE_URL}/calls/request`,
  
  // Вебхук для входящих уведомлений
  WEBAHOOK_URL: process.env.WEBHOOK_URL || '',
};

// ============================================
// 🔔 НАСТРОЙКИ УВЕДОМЛЕНИЙ
// ============================================

export const NOTIFICATION_CONFIG = {
  DEFAULT_CHANNEL_ID: 'max_messages',
  CALLS_CHANNEL_ID: 'max_calls',
  
  // Звук уведомления (Android)
  DEFAULT_SOUND: 'default',
  CALL_SOUND: 'ringtone_default',
  
  // Автозакрытие через мс
  AUTO_DISMISS_DELAY: 5000,
  
  // Максимум показов в фоне одновременно
  MAX_CONCURRENT_NOTIFS: 10,
};

// ============================================
// 📦 ИМПОРТ SDK FIREBASE
// ============================================

import { initializeApp } from 'firebase/app';
import { getAnalytics } from 'firebase/analytics';
import { getMessaging, getToken, onMessage } from 'firebase/messaging';
import { getDatabase } from 'firebase/database';
import { getStorage } from 'firebase/storage';

// Инициализация
const app = initializeApp(firebaseConfig);

// Экспорты сервисов
export const analytics = getAnalytics(app);
export const messaging = getMessaging(app);
export const db = getDatabase(app);
export const storage = getStorage(app);

// ============================================
// 🔔 SERVICE WORKER (для push в фоне)
// ============================================

