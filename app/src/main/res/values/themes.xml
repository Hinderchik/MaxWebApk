<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MaxDesktop.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_dark_light</item>
        <item name="android:statusBarColor">@color/primary_light</item>
        <item name="android:windowBackground">@color/bg_main_light</item>
    </style>
    <style name="Theme.MaxDesktop.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg_main_dark</item>
    </style>
    <style name="Theme.MaxDesktop.Brand" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_start</item>
        <item name="colorPrimaryVariant">@color/brand_end</item>
        <item name="android:statusBarColor">@color/brand_start</item>
        <item name="android:windowBackground">@color/bg_main_light</item>
    </style>
</resources>